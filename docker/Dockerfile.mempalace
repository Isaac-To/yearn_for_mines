FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mempalace==3.10.0 "mcp>=1.12,<2"

COPY docker/mempalace_http.py /app/mempalace_http.py

EXPOSE 8080

CMD ["python", "/app/mempalace_http.py"]
